# macOS
.DS_Store

# Xcode 用户本地的窗口布局等个人状态，不入库
xcuserdata/
DerivedData/

# Swift Package Manager
.build/

# 本地性能录制和测试结果，可重新生成
audits/**/*.trace/
*.xcresult/

# 本地凭据和签名文件
.env
.env.*
!.env.example
*.p12
*.mobileprovision
# 本地签名证书、描述文件和临时钥匙串
signing/

# 开发过程记录、参考源码快照与截图只留在本地，不入库（避免 fork 下载大文件）
audits/
references/PiliPlus/
screenshot_home.png
# 官网参考用的真机截图含账号头像、关注列表和他人视频画面
design/website-screenshots/

# 独立产品网站与旧图标方案保留在本地，不随 App 源码分发
/website/
/design/app-icon-2026/*.png
!/design/app-icon-2026/BMark-production.png

# Local device build cache
.build-device/
