# Operating-system and editor state
.DS_Store
xcuserdata/
*.xcuserstate

# Reproducible Xcode / Swift build and test output
/DerivedData/
/.build-device/
.build/
*.xcresult/
*.trace/
.swiftpm/xcode/package.xcworkspace/xcuserdata/

# Python helpers: generated caches and local environments
__pycache__/
*.py[cod]
.pytest_cache/
.venv/

# Local credentials and signing material (keep example configuration)
.env
.env.*
!.env.example
*.p12
*.mobileprovision
/signing/

# Private captures, local reference checkout and account-bearing screenshots
/audits/
/references/PiliPlus/
/screenshot_home.png
/design/website-screenshots/

# Separate website and unused icon experiments; retain the production asset
/website/
/design/app-icon-2026/*.png
!/design/app-icon-2026/BMark-production.png
