        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With System, NeoBili uses Chinese when your system language is Chinese and English otherwise. Content from Bilibili (titles, comments, trending searches and so on) stays in its original language."
          }
        }
      }
    },
