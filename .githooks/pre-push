#!/bin/bash
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"
# Consume Git's ref list before launching tools that may read standard input.
cat > /dev/null
echo 'pre-push: running quick validation'
if ! bash scripts/verify.sh quick; then
    echo 'pre-push: quick validation failed; push blocked.' >&2
    exit 1
fi
echo 'pre-push: quick checks passed; full regression is required before PR submission and in CI.'
